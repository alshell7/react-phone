# Copy to .env.local (git-ignored) to run live SIP tests against your own PBX.
# Never commit real credentials or expose the password through EXPO_PUBLIC_ variables.
SIP_WSS_URL=wss://pbx.example.com:8089/ws
SIP_URI=sip:1001@pbx.example.com
SIP_USERNAME=1001
SIP_PASSWORD=
# Optional: a destination that answers (echo test, voicemail, or a second device).
SIP_TEST_TARGET=
