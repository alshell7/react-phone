{
  "expo": {
    "name": "Azeer Phone",
    "slug": "azeer-phone-playground",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.azeer.phone.playground",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip"]
      }
    },
    "android": {
      "package": "dev.azeer.phone.playground",
      "adaptiveIcon": {
        "backgroundColor": "#E9F1EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Azeer Phone · React Native playground"
    },
    "plugins": [
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Calls need your microphone so the other person can hear you.",
          "cameraPermission": "This app does not use the camera."
        }
      ]
    ]
  }
}
