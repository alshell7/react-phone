{
  "name": "@azeer-ui-widget/react-native-phone",
  "version": "0.1.0",
  "description": "Composable, themeable React Native SIP phone for iOS, Android, and the web. JsSIP + react-native-webrtc, a dynamic island, and live audio visuals.",
  "license": "MIT",
  "homepage": "https://alshell7.github.io/react-phone/native/",
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "sip",
    "webrtc",
    "softphone",
    "voip",
    "jssip",
    "dynamic-island",
    "dialer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alshell7/react-phone.git",
    "directory": "native"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "sideEffects": false,
  "workspaces": [
    "example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "test": "jest",
    "test:live": "jest --config jest.live.config.cjs --runInBand",
    "test:e2e": "playwright test",
    "check": "npm run package:check && npm run typecheck && npm test",
    "package:build": "node scripts/build-package.mjs",
    "package:check": "node scripts/build-package.mjs --check",
    "publish:check": "npm run package:check && npm run publish:stage && cd .jsr-stage && npx --yes jsr publish --dry-run --allow-dirty",
    "example": "npm run start --workspace example",
    "playground:build": "npm run build:web --workspace example",
    "publish:stage": "node scripts/stage-jsr.mjs",
    "docs:screenshots": "npm run playground:build && node scripts/capture-screenshots.mjs",
    "test:staged": "npm run publish:stage && PHONE_PACKAGE=staged npm run playground:build && playwright test",
    "test:live:call": "SIP_LIVE=1 playwright test --project=live-sip"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-svg": ">=15.0.0",
    "react-native-webrtc": ">=124.0.0"
  },
  "dependencies": {
    "jssip": "^3.13.9",
    "lucide-react-native": "^1.64.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@playwright/test": "^1.64.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "babel-jest": "^30.0.0",
    "jest": "^30.5.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "^15.16.0",
    "react-native-webrtc": "^124.0.8",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
